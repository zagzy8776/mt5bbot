# Application
APP_NAME=mt5-platform
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# Bearer token for every route except /health. REQUIRED if API_HOST is not 127.0.0.1.
API_TOKEN=
# Browser origins allowed to call the API (your dashboard URL), comma-separated.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Trading mode — DEMO is the only safe default.
# LIVE requires BOTH flags below AND TradingMode.LIVE in config.
TRADING_MODE=demo
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACKNOWLEDGED=false

# Primary symbol (architecture remains multi-symbol)
DEFAULT_SYMBOL=XAUUSD

# Risk defaults (overridable per strategy/account)
# Conservative demo defaults: size to your account, do not copy blindly.
MAX_POSITION_SIZE=0.02
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_SIMULTANEOUS_POSITIONS=3
MAX_SPREAD_POINTS=500.0
MAX_SLIPPAGE_POINTS=25.0
MAX_EXPOSURE_PCT=300.0
MIN_MARGIN_LEVEL_PCT=20.0
STALE_DATA_MAX_AGE_MS=5000

# Kill switch — when true, no new orders may be submitted
EMERGENCY_KILL_SWITCH=false
# Persist kill switch / pause across restarts (recommended). Corrupt file => stays halted.
RISK_STATE_PATH=./risk_state.json
# Always enforced when EXECUTION_BACKEND=mt5; set true to enforce it with the mock too.
REQUIRE_INSTRUMENT_SPEC=false

# Ingestion (Phase 2+)
INGESTION_WORKERS=4
INGESTION_ENABLED=false
INGESTION_STALE_CONTEXT_S=300
PROXY_COOLDOWN_S=30
PROXY_QUARANTINE_S=300
# Set true only after confirming which resources a dashboard needs
RESOURCE_FILTER_CALIBRATED=false

# Database (Phase 3+)
# STORAGE_BACKEND: memory | sqlite | postgres
# For Aiven / hosted PostgreSQL: set STORAGE_BACKEND=postgres and provide the
# Service URI via DATABASE_URL.  The URI must use the postgres:// scheme;
# sslmode=require is handled automatically by the engine.
# NEVER commit .env — set DATABASE_URL via environment variable or secret manager.
STORAGE_BACKEND=memory
DATABASE_URL=sqlite+aiosqlite:///./mt5_platform.db
REDIS_URL=redis://127.0.0.1:6379/0

# Strategy / signal engine (Phase 4)
# Comma-separated registry names: null | sma_crossover | breakout | mean_reversion | momentum
STRATEGIES=sma_crossover,breakout
SIGNAL_MIN_CONFIDENCE=0.0
SIGNAL_REQUIRE_STOP_LOSS=true
SIGNAL_COOLDOWN_S=0.0
SIGNAL_STORE_SINK_ENABLED=true
SIGNAL_AUDIT_STORE_SINK_ENABLED=true

# Order / execution engine (Phase 6) — EXECUTION_BACKEND: mock | mt5
# "mt5" arrives in Phase 7 and refuses to run until then; mock is the default.
EXECUTION_BACKEND=mock
MOCK_STARTING_BALANCE=10000.0
MOCK_SLIPPAGE=0.0
MOCK_FILL_RATIO=1.0
ORDER_STORE_SINK_ENABLED=true

# MT5 (Phase 7+) — demo account only until validation complete
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=10000
# Tags this bot's orders so it never touches your manual trades.
MT5_MAGIC=26092101
# External/manual positions: ignore (visible only), observe (evaluate/no execution), manage.
# MANAGE still routes any modification/exit through PositionManager -> RiskEngine -> OrderManager.
MANUAL_POSITION_POLICY=ignore
# Written by `python -m mt5_platform.backtest run`. LIVE mode refuses to start without a
# passing report for the same symbol/timeframe.
VALIDATION_REPORT_PATH=./validation_report.json

# Intelligence layer: MarketContext + Agents + Synthesis + Historical + PositionManager + Learning.
# Default off. When on, the loop also runs the agent network on every cycle and evaluates
# open positions. Thesis-driven signals go through the SAME risk/order pipeline.
INTELLIGENCE_ENABLED=false
# In-trade management (trailing / break-even / reductions / exits) runs whenever
# INTELLIGENCE_ENABLED=true. The agent/synthesis ENTRY path is separate and stays off unless this
# is enabled, so the strategy registry remains the entry source of record.
INTELLIGENCE_ENTRIES_ENABLED=false

# Strategy registry names for STRATEGIES (comma-separated). Families:
#   null | sma_crossover | breakout | mean_reversion | momentum | atr_breakout | ema_adx_trend |
#   bollinger_reversion | rsi_ema_pullback | session_breakout | mtf_trend | structure_breakout

# ----- Macro/news calendar (no source is bundled; off by default) -----
NEWS_ENABLED=false
# NEWS_PROVIDER: off | file | http
NEWS_PROVIDER=off
NEWS_FILE_PATH=
NEWS_HTTP_URL=
# Mandatory allow-list for http providers (empty = no request is ever made), comma-separated.
NEWS_HTTP_ALLOW=
NEWS_LOOK_BACK_HOURS=24
NEWS_LOOK_AHEAD_HOURS=48
NEWS_POLL_INTERVAL_S=900
# Opt-in protection: refuses NEW entries around high-impact events for the symbol's currencies.
# It adds a restriction and never relaxes one; open positions are unaffected.
NEWS_BLACKOUT_ENABLED=false
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15
# NEWS_BLACKOUT_MIN_IMPACT: high | medium
NEWS_BLACKOUT_MIN_IMPACT=high

# ----- Research -> runtime promotion (explicit approval only) -----
# Empty means the runtime ignores the file and keeps using STRATEGIES. Nothing is promoted
# automatically: approve a validated candidate with scripts/promote_candidate.py.
PROMOTION_CONFIG_PATH=

# ----- Autonomous web research (off by default) -----
# Research reads only allow-listed sources and produces hypotheses to test. It cannot change
# configuration, risk limits or live trading. An empty allow-list fetches nothing.
WEB_INTEL_ENABLED=false
WEB_INTEL_SOURCES=
WEB_INTEL_ALLOW=
WEB_INTEL_MAX_SOURCES=10
WEB_INTEL_MAX_BYTES_PER_PAGE=200000
WEB_INTEL_MAX_TOTAL_BYTES=1000000
WEB_INTEL_TIMEOUT_S=8
