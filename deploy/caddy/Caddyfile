# Caddy reverse proxy for the FastAPI control plane + frontend static files.
#
# Run:     C:\caddy.exe run --config C:\mt5bbot\deploy\caddy\Caddyfile
#
# SETUP:
#   1. Create DNS A record: api.<YOURDOMAIN> -> 13.53.232.117
#   2. Replace "<YOURDOMAIN>" below with your actual domain
#   3. Caddy auto-provisions HTTPS via Let's Encrypt (port 80 + 443 must be open)
#   4. Update CORS_ORIGINS in .env to include https://frontend-three-eta-53.vercel.app
#   5. Update VITE_API_BASE_URL in Vercel to https://api.<YOURDOMAIN>
#
# FastAPI listens on 127.0.0.1:8000 only. All external access goes through Caddy.

api.<YOURDOMAIN> {
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
    # Health probe — public, no auth required (app layer handles it)
    @health path /health
    handle @health {
        reverse_proxy 127.0.0.1:8000
    }
    # Serve frontend static assets
    @static path /assets/*
    handle @static {
        root * C:\mt5bbot\frontend\dist
        file_server
    }
    # Everything else -> FastAPI (SPA fallback + API routes)
    handle {
        reverse_proxy 127.0.0.1:8000
    }
    log {
        output file C:\mt5bbot\logs\caddy.log
    }
}
