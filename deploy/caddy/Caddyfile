# Caddy: serves frontend + API on port 80 (HTTP).
#
# Architecture: browser at http://13.53.232.117 → Caddy :80
#   /health, /api/* → FastAPI 127.0.0.1:8000
#   /assets/*       → frontend/dist (static files)
#   /*              → frontend/dist/index.html (SPA fallback)
#
# FastAPI listens on 127.0.0.1:8000 only. All external access through Caddy.
# When a domain is available, replace ":80" with "api.<YOURDOMAIN>" for HTTPS.

:80 {
    reverse_proxy 127.0.0.1:8000
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
    # Health probe — public
    @health path /health
    handle @health {
        reverse_proxy 127.0.0.1:8000
    }
    # Serve frontend static assets
    @static path /assets/*
    handle @static {
        root * C:\mt5bbot\frontend\dist
        file_server
    }
    # SPA: non-API, non-asset routes → index.html
    @spa not path /api/* /health /assets/*
    handle @spa {
        root * C:\mt5bbot\frontend\dist
        try_files {path} /index.html
        file_server
    }
    # API routes → FastAPI
    handle {
        reverse_proxy 127.0.0.1:8000
    }
    log {
        output file C:\mt5bbot\logs\caddy.log
    }
}
