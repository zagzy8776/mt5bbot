# Caddy reverse proxy for the FastAPI control plane + frontend static files.
#
# Run:     C:\caddy.exe run --config C:\mt5bbot\deploy\caddy\Caddyfile
#
# CURRENT: HTTP on :80 (no domain configured yet).
# WHEN DOMAIN READY:
#   1. Create DNS A record: api.YOURDOMAIN.com -> 13.53.232.117
#   2. Replace ":80" below with "api.YOURDOMAIN.com"
#   3. Caddy auto-provisions HTTPS via Let's Encrypt
#   4. Update CORS_ORIGINS in .env to include https://app.YOURDOMAIN.com
#   5. Update VITE_API_BASE_URL in Vercel to https://api.YOURDOMAIN.com
#
# FastAPI listens on 127.0.0.1:8000 only. All external access goes through Caddy.

:80 {
    reverse_proxy 127.0.0.1:8000
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
    # Health probe — public, no auth required (app layer handles it)
    @health path /health
    handle @health {
        reverse_proxy 127.0.0.1:8000
    }
    # Serve frontend static assets
    @static path /assets/*
    handle @static {
        root * C:\mt5bbot\frontend\dist
        file_server
    }
    # Everything else -> FastAPI (SPA fallback + API routes)
    handle {
        reverse_proxy 127.0.0.1:8000
    }
    log {
        output file C:\mt5bbot\logs\caddy.log
    }
}
